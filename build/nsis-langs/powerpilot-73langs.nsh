LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\Kazakh.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1087 "Power Pilot орнату шеберіне қош келдіңіз"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1087 "Vellium жасаған Power Pilot Windows қуат басқаруын және жоспарланған тапсырмаларды қауіпсіз автоматтандырады.$\r$\n$\r$\nБарлық тапсырмалар, баптаулар және жергілікті AI модельдері толығымен офлайн күйде компьютеріңізде сақталады.$\r$\n$\r$\nЖалғастыру үшін Келесі түймесін басыңыз."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1087 "Power Pilot жою"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1087 "Бұл шебер Power Pilot (Vellium) қолданбасын компьютеріңізден жояды.$\r$\n$\r$\nКелесі қадамда жергілікті деректеріңізді сақтауды немесе толық өшіруді таңдай аласыз."
LangString MUI_TEXT_DIRECTORY_TITLE 1087 "Орнату орнын таңдаңыз"
