LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\TurkishTR.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1055 "Power Pilot Kurulumuna Hoş Geldiniz"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1055 "Power Pilot, bilgisayarınızın güç yönetimini ve zamanlanmış otomasyon görevlerini güvenle yönetmeniz için Vellium tarafından geliştirildi.$\r$\n$\r$\nTüm görevleriniz, ayarlarınız ve yerel yapay zeka modelleriniz tamamen çevrimdışı olarak bilgisayarınızda saklanır.$\r$\n$\r$\nDevam etmek için İleri'ye tıklayın."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1055 "Power Pilot Kaldırma Sihirbazı"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1055 "Bu sihirbaz Power Pilot (Vellium) uygulamasını bilgisayarınızdan kaldıracaktır.$\r$\n$\r$\nSonraki adımda yerel görevlerinizi, geçmişinizi ve ayarlarınızı saklamayı veya kalıcı olarak silmeyi seçebilirsiniz."
LangString MUI_TEXT_DIRECTORY_TITLE 1055 "Kurulum Klasörünü Seçin"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1055 "$(^NameDA) uygulamasını kurmak istediğiniz klasörü seçin."
LangString MUI_TEXT_INSTALLING_TITLE 1055 "Kuruluyor"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1055 "$(^NameDA) kurulurken lütfen bekleyin."
LangString MUI_TEXT_FINISH_TITLE 1055 "Kurulum Tamamlandı"
LangString MUI_TEXT_FINISH_SUBTITLE 1055 "Kurulum başarıyla tamamlandı."
LangString MUI_TEXT_ABORT_TITLE 1055 "Kurulum İptal Edildi"
LangString MUI_TEXT_ABORT_SUBTITLE 1055 "Kurulum tamamlanamadı."
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1055 "Kaldırılıyor"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1055 "$(^NameDA) bilgisayarınızdan kaldırılırken lütfen bekleyin."
LangString MUI_UNTEXT_FINISH_TITLE 1055 "Kaldırma Tamamlandı"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1055 "Kaldırma işlemi başarıyla tamamlandı."
LangString MUI_UNTEXT_ABORT_TITLE 1055 "Kaldırma İptal Edildi"
