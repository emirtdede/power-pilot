LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\Tamil.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1097 "Power Pilot நிறுவலுக்கு வரவேற்கிறோம்"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1097 "Vellium உருவாக்கிய Power Pilot உங்கள் Windows மின் மேலாண்மை மற்றும் திட்டமிட்ட பணிகளைப் பாதுகாப்பாகத் தானியக்கமாக்குகிறது.$\r$\n$\r$\nஅனைத்து பணிகள், அமைப்புகள் மற்றும் உள்ளூர் AI மாதிரிகள் முற்றிலும் ஆஃப்லைனில் உங்கள் கணினியில் இருக்கும்.$\r$\n$\r$\nதொடர அடுத்து என்பதைக் கிளிக் செய்யவும்."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1097 "Power Pilot நீக்கம்"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1097 "இந்த வழிகாட்டி உங்கள் கணினியிலிருந்து Power Pilot (Vellium) ஐ நீக்கும்.$\r$\n$\r$\nஅடுத்த படியில் உள்ளூர் தரவை வைத்திருக்க வேண்டுமா அல்லது நிரந்தரமாக அழிக்க வேண்டுமா என்பதைத் தேர்ந்தெடுக்கலாம்."
LangString MUI_TEXT_DIRECTORY_TITLE 1097 "நிறுவல் இடத்தைத் தேர்ந்தெடுக்கவும்"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1097 "$(^NameDA) ஐ நிறுவ வேண்டிய கோப்புறையைத் தேர்ந்தெடுக்கவும்."
LangString MUI_TEXT_INSTALLING_TITLE 1097 "நிறுவப்படுகிறது"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1097 "$(^NameDA) நிறுவப்படும் வரை காத்திருக்கவும்."
LangString MUI_TEXT_FINISH_TITLE 1097 "நிறுவல் முடிந்தது"
LangString MUI_TEXT_FINISH_SUBTITLE 1097 "நிறுவல் வெற்றிகரமாக முடிந்தது."
LangString MUI_TEXT_ABORT_TITLE 1097 "நிறுவல் நிறுத்தப்பட்டது"
LangString MUI_TEXT_ABORT_SUBTITLE 1097 "நிறுவல் வெற்றிகரமாக முடியவில்லை."
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1097 "நீக்கப்படுகிறது"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1097 "$(^NameDA) நீக்கப்படும் வரை காத்திருக்கவும்."
LangString MUI_UNTEXT_FINISH_TITLE 1097 "நீக்கம் முடிந்தது"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1097 "நீக்கம் வெற்றிகரமாக முடிந்தது."
LangString MUI_UNTEXT_ABORT_TITLE 1097 "நீக்கம் நிறுத்தப்பட்டது"
LangString MUI_UNTEXT_ABORT_SUBTITLE 1097 "நீக்கம் வெற்றிகரமாக முடியவில்லை."
LangString MUI_TEXT_FINISH_INFO_TITLE 1097 "Power Pilot நிறுவல் முடிந்தது"
LangString MUI_TEXT_FINISH_INFO_TEXT 1097 "Power Pilot உங்கள் கணினியில் வெற்றிகரமாக நிறுவப்பட்டது.$\r$\n$\r$\nஇந்த வழிகாட்டியை மூட முடி என்பதைக் கிளிக் செய்யவும்."
LangString MUI_TEXT_FINISH_INFO_REBOOT 1097 "செயல்முறையை முடிக்க கணினியை மறுதொடக்கம் செய்ய வேண்டும். இப்போது மறுதொடக்கம் செய்யவா?"
LangString MUI_UNTEXT_FINISH_INFO_TITLE 1097 "Power Pilot நீக்கப்பட்டது"
LangString MUI_UNTEXT_FINISH_INFO_TEXT 1097 "Power Pilot உங்கள் கணினியிலிருந்து வெற்றிகரமாக நீக்கப்பட்டது.$\r$\n$\r$\nஆதரவு: support@vellium.dev"
LangString MUI_UNTEXT_FINISH_INFO_REBOOT 1097 "செயல்முறையை முடிக்க கணினியை மறுதொடக்கம் செய்ய வேண்டும். இப்போது மறுதொடக்கம் செய்யவா?"
LangString MUI_TEXT_FINISH_REBOOTNOW 1097 "இப்போது மறுதொடக்கம் செய்"
LangString MUI_TEXT_FINISH_REBOOTLATER 1097 "பின்னர் நானே மறுதொடக்கம் செய்வேன்"
LangString MUI_TEXT_FINISH_RUN 1097 "$(^NameDA) ஐ &இயக்கு"
LangString MUI_TEXT_FINISH_SHOWREADME 1097 "Readme ஐ &காட்டு"
LangString MUI_BUTTONTEXT_FINISH 1097 "&முடி"
LangString MUI_TEXT_ABORTWARNING 1097 "$(^Name) நிறுவலிலிருந்து வெளியேற விரும்புகிறீர்களா?"
LangString MUI_UNTEXT_ABORTWARNING 1097 "$(^Name) நீக்கத்திலிருந்து வெளியேற விரும்புகிறீர்களா?"

LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\Telugu.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1098 "Power Pilot సెటప్‌కు స్వాగతం"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1098 "Vellium రూపొందించిన Power Pilot మీ Windows పవర్ మేనేజ్‌మెంట్ మరియు షెడ్యూల్ చేసిన పనులను సురక్షితంగా ఆటోమేట్ చేస్తుంది.$\r$\n$\r$\nఅన్ని పనులు, సెట్టింగ్‌లు మరియు లోకల్ AI మోడల్స్ పూర్తిగా ఆఫ్‌లైన్‌లో మీ PCలోనే ఉంటాయి.$\r$\n$\r$\nకొనసాగడానికి తదుపరి క్లిక్ చేయండి."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1098 "Power Pilot అన్‌ఇన్‌స్టాల్"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1098 "ఈ విజార్డ్ మీ కంప్యూటర్ నుండి Power Pilot (Vellium) ను తొలగిస్తుంది.$\r$\n$\r$\nతదుపరి దశలో మీ లోకల్ డేటాను ఉంచుకోవాలా లేదా శాశ్వతంగా తొలగించాలా అని ఎంచుకోవచ్చు."
LangString MUI_TEXT_DIRECTORY_TITLE 1098 "ఇన్‌స్టాలేషన్ స్థానాన్ని ఎంచుకోండి"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1098 "$(^NameDA) ను ఇన్‌స్టాల్ చేయాల్సిన ఫోల్డర్‌ను ఎంచుకోండి."
LangString MUI_TEXT_INSTALLING_TITLE 1098 "ఇన్‌స్టాల్ అవుతోంది"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1098 "$(^NameDA) ఇన్‌స్టాల్ అయ్యే వరకు దయచేసి వేచి ఉండండి."
LangString MUI_TEXT_FINISH_TITLE 1098 "ఇన్‌స్టాలేషన్ పూర్తయింది"
LangString MUI_TEXT_FINISH_SUBTITLE 1098 "సెటప్ విజయవంతంగా పూర్తయింది."
LangString MUI_TEXT_ABORT_TITLE 1098 "ఇన్‌స్టాలేషన్ నిలిపివేయబడింది"
LangString MUI_TEXT_ABORT_SUBTITLE 1098 "సెటప్ విజయవంతంగా పూర్తి కాలేదు."
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1098 "అన్‌ఇన్‌స్టాల్ అవుతోంది"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1098 "$(^NameDA) తొలగించబడే వరకు దయచేసి వేచి ఉండండి."
LangString MUI_UNTEXT_FINISH_TITLE 1098 "అన్‌ఇన్‌స్టాల్ పూర్తయింది"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1098 "అన్‌ఇన్‌స్టాల్ విజయవంతంగా పూర్తయింది."
LangString MUI_UNTEXT_ABORT_TITLE 1098 "అన్‌ఇన్‌స్టాల్ నిలిపివేయబడింది"
LangString MUI_UNTEXT_ABORT_SUBTITLE 1098 "అన్‌ఇన్‌స్టాల్ విజయవంతంగా పూర్తి కాలేదు."
LangString MUI_TEXT_FINISH_INFO_TITLE 1098 "Power Pilot ఇన్‌స్టాలేషన్ పూర్తయింది"
LangString MUI_TEXT_FINISH_INFO_TEXT 1098 "Power Pilot మీ కంప్యూటర్‌లో విజయవంతంగా ఇన్‌స్టాల్ చేయబడింది.$\r$\n$\r$\nఈ విజార్డ్‌ను మూసివేయడానికి ముగించు క్లిక్ చేయండి."
LangString MUI_TEXT_FINISH_INFO_REBOOT 1098 "ప్రక్రియను పూర్తి చేయడానికి కంప్యూటర్‌ను పునఃప్రారంభించాలి. ఇప్పుడే పునఃప్రారంభించాలా?"
LangString MUI_UNTEXT_FINISH_INFO_TITLE 1098 "Power Pilot తొలగించబడింది"
LangString MUI_UNTEXT_FINISH_INFO_TEXT 1098 "Power Pilot మీ కంప్యూటర్ నుండి విజయవంతంగా తొలగించబడింది.$\r$\n$\r$\nమద్దతు: support@vellium.dev"
LangString MUI_UNTEXT_FINISH_INFO_REBOOT 1098 "ప్రక్రియను పూర్తి చేయడానికి కంప్యూటర్‌ను పునఃప్రారంభించాలి. ఇప్పుడే పునఃప్రారంభించాలా?"
LangString MUI_TEXT_FINISH_REBOOTNOW 1098 "ఇప్పుడే పునఃప్రారంభించు"
LangString MUI_TEXT_FINISH_REBOOTLATER 1098 "నేను తర్వాత పునఃప్రారంభిస్తాను"
LangString MUI_TEXT_FINISH_RUN 1098 "$(^NameDA) &ప్రారంభించు"
LangString MUI_TEXT_FINISH_SHOWREADME 1098 "Readme &చూపించు"
LangString MUI_BUTTONTEXT_FINISH 1098 "&ముగించు"
LangString MUI_TEXT_ABORTWARNING 1098 "మీరు ఖచ్చితంగా $(^Name) సెటప్ నుండి నిష్క్రమించాలనుకుంటున్నారా?"
LangString MUI_UNTEXT_ABORTWARNING 1098 "మీరు ఖచ్చితంగా $(^Name) అన్‌ఇన్‌స్టాల్ నుండి నిష్క్రమించాలనుకుంటున్నారా?"

LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\Marathi.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1102 "Power Pilot सेटअपमध्ये स्वागत आहे"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1102 "Vellium निर्मित Power Pilot Windows चे पॉवर व्यवस्थापन आणि नियोजित कार्ये सुरक्षितपणे स्वयंचलित करते.$\r$\n$\r$\nतुमची सर्व कार्ये, सेटिंग्ज आणि स्थानिक AI मॉडेल्स पूर्णपणे ऑफलाइन तुमच्या PC वर राहतात.$\r$\n$\r$\nपुढे जाण्यासाठी पुढे क्लिक करा."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1102 "Power Pilot अनइंस्टॉल"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1102 "हा विझार्ड तुमच्या संगणकावरून Power Pilot (Vellium) काढून टाकेल.$\r$\n$\r$\nपुढील टप्प्यात तुम्ही स्थानिक डेटा ठेवायचा की कायमचा हटवायचा ते निवडू शकता."
LangString MUI_TEXT_DIRECTORY_TITLE 1102 "इंस्टॉलेशन स्थान निवडा"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1102 "$(^NameDA) इंस्टॉल करण्यासाठी फोल्डर निवडा."
LangString MUI_TEXT_INSTALLING_TITLE 1102 "इंस्टॉल होत आहे"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1102 "$(^NameDA) इंस्टॉल होईपर्यंत कृपया प्रतीक्षा करा."
LangString MUI_TEXT_FINISH_TITLE 1102 "इंस्टॉलेशन पूर्ण झाले"
LangString MUI_TEXT_FINISH_SUBTITLE 1102 "सेटअप यशस्वीरित्या पूर्ण झाला."
LangString MUI_TEXT_ABORT_TITLE 1102 "इंस्टॉलेशन रद्द झाले"
LangString MUI_TEXT_ABORT_SUBTITLE 1102 "सेटअप यशस्वीरित्या पूर्ण झाला नाही."
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1102 "अनइंस्टॉल होत आहे"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1102 "$(^NameDA) काढले जाईपर्यंत कृपया प्रतीक्षा करा."
LangString MUI_UNTEXT_FINISH_TITLE 1102 "अनइंस्टॉल पूर्ण झाले"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1102 "अनइंस्टॉल यशस्वीरित्या पूर्ण झाले."
LangString MUI_UNTEXT_ABORT_TITLE 1102 "अनइंस्टॉल रद्द झाले"
LangString MUI_UNTEXT_ABORT_SUBTITLE 1102 "अनइंस्टॉल यशस्वीरित्या पूर्ण झाले नाही."
LangString MUI_TEXT_FINISH_INFO_TITLE 1102 "Power Pilot इंस्टॉलेशन पूर्ण झाले"
LangString MUI_TEXT_FINISH_INFO_TEXT 1102 "Power Pilot तुमच्या संगणकावर यशस्वीरित्या इंस्टॉल झाले आहे.$\r$\n$\r$\nहा विझार्ड बंद करण्यासाठी पूर्ण क्लिक करा."
LangString MUI_TEXT_FINISH_INFO_REBOOT 1102 "प्रक्रिया पूर्ण करण्यासाठी संगणक रीस्टार्ट करणे आवश्यक आहे. आता रीस्टार्ट करायचे का?"
LangString MUI_UNTEXT_FINISH_INFO_TITLE 1102 "Power Pilot काढून टाकले"
LangString MUI_UNTEXT_FINISH_INFO_TEXT 1102 "Power Pilot तुमच्या संगणकावरून यशस्वीरित्या काढून टाकले गेले आहे.$\r$\n$\r$\nमदत: support@vellium.dev"
LangString MUI_UNTEXT_FINISH_INFO_REBOOT 1102 "प्रक्रिया पूर्ण करण्यासाठी संगणक रीस्टार्ट करणे आवश्यक आहे. आता रीस्टार्ट करायचे का?"
LangString MUI_TEXT_FINISH_REBOOTNOW 1102 "आता रीस्टार्ट करा"
LangString MUI_TEXT_FINISH_REBOOTLATER 1102 "मी नंतर स्वतः रीस्टार्ट करेन"
LangString MUI_TEXT_FINISH_RUN 1102 "$(^NameDA) &सुरू करा"
LangString MUI_TEXT_FINISH_SHOWREADME 1102 "Readme &दाखवा"
LangString MUI_BUTTONTEXT_FINISH 1102 "&पूर्ण करा"
LangString MUI_TEXT_ABORTWARNING 1102 "तुम्हाला नक्की $(^Name) सेटअप बंद करायचा आहे का?"
