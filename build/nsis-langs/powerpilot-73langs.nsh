LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\Kannada.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1099 "Power Pilot ಸೆಟಪ್‌ಗೆ ಸ್ವಾಗತ"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1099 "Vellium ನಿರ್ಮಿಸಿದ Power Pilot Windows ವಿದ್ಯುತ್ ನಿರ್ವಹಣೆ ಮತ್ತು ನಿಗದಿತ ಕಾರ್ಯಗಳನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಸ್ವಯಂಚಾಲಿತಗೊಳಿಸುತ್ತದೆ.$\r$\n$\r$\nನಿಮ್ಮ ಎಲ್ಲಾ ಕಾರ್ಯಗಳು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮತ್ತು ಸ್ಥಳೀಯ AI ಮಾದರಿಗಳು ಸಂಪೂರ್ಣವಾಗಿ ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ನಿಮ್ಮ PCಯಲ್ಲಿಯೇ ಇರುತ್ತವೆ.$\r$\n$\r$\nಮುಂದುವರಿಯಲು ಮುಂದೆ ಕ್ಲಿಕ್ ಮಾಡಿ."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1099 "Power Pilot ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1099 "ಈ ವಿಝಾರ್ಡ್ ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಿಂದ Power Pilot (Vellium) ಅನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ.$\r$\n$\r$\nಮುಂದಿನ ಹಂತದಲ್ಲಿ ನಿಮ್ಮ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ಉಳಿಸಿಕೊಳ್ಳಬೇಕೆ ಅಥವಾ ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಬೇಕೆ ಎಂದು ಆಯ್ಕೆ ಮಾಡಬಹುದು."
LangString MUI_TEXT_DIRECTORY_TITLE 1099 "ಸ್ಥಾಪನೆ ಸ್ಥಳವನ್ನು ಆಯ್ಕೆಮಾಡಿ"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1099 "$(^NameDA) ಸ್ಥಾಪಿಸಬೇಕಾದ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ."
LangString MUI_TEXT_INSTALLING_TITLE 1099 "ಸ್ಥಾಪಿಸಲಾಗುತ್ತಿದೆ"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1099 "$(^NameDA) ಸ್ಥಾಪನೆಯಾಗುವವರೆಗೆ ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ."
LangString MUI_TEXT_FINISH_TITLE 1099 "ಸ್ಥಾಪನೆ ಪೂರ್ಣಗೊಂಡಿದೆ"
LangString MUI_TEXT_FINISH_SUBTITLE 1099 "ಸೆಟಪ್ ಯಶಸ್ವಿಯಾಗಿ ಪೂರ್ಣಗೊಂಡಿದೆ."
LangString MUI_TEXT_ABORT_TITLE 1099 "ಸ್ಥಾಪನೆ ನಿಲ್ಲಿಸಲಾಗಿದೆ"
LangString MUI_TEXT_ABORT_SUBTITLE 1099 "ಸೆಟಪ್ ಯಶಸ್ವಿಯಾಗಿ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ."
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1099 "ತೆಗೆದುಹಾಕಲಾಗುತ್ತಿದೆ"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1099 "$(^NameDA) ತೆಗೆದುಹಾಕುವವರೆಗೆ ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ."
LangString MUI_UNTEXT_FINISH_TITLE 1099 "ತೆಗೆದುಹಾಕುವಿಕೆ ಪೂರ್ಣಗೊಂಡಿದೆ"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1099 "ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಯಶಸ್ವಿಯಾಗಿ ಪೂರ್ಣಗೊಂಡಿದೆ."
LangString MUI_UNTEXT_ABORT_TITLE 1099 "ತೆಗೆದುಹಾಕುವಿಕೆ ನಿಲ್ಲಿಸಲಾಗಿದೆ"
LangString MUI_UNTEXT_ABORT_SUBTITLE 1099 "ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಯಶಸ್ವಿಯಾಗಿ ಪೂರ್ಣಗೊಳ್ಳಲಿಲ್ಲ."
LangString MUI_TEXT_FINISH_INFO_TITLE 1099 "Power Pilot ಸ್ಥಾಪನೆ ಪೂರ್ಣಗೊಂಡಿದೆ"
LangString MUI_TEXT_FINISH_INFO_TEXT 1099 "Power Pilot ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ ಯಶಸ್ವಿಯಾಗಿ ಸ್ಥಾಪಿಸಲಾಗಿದೆ.$\r$\n$\r$\nಈ ವಿಝಾರ್ಡ್ ಮುಚ್ಚಲು ಮುಕ್ತಾಯ ಕ್ಲಿಕ್ ಮಾಡಿ."
LangString MUI_TEXT_FINISH_INFO_REBOOT 1099 "ಪ್ರಕ್ರಿಯೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು. ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆ?"
LangString MUI_UNTEXT_FINISH_INFO_TITLE 1099 "Power Pilot ತೆಗೆದುಹಾಕಲಾಗಿದೆ"
LangString MUI_UNTEXT_FINISH_INFO_TEXT 1099 "Power Pilot ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಿಂದ ಯಶಸ್ವಿಯಾಗಿ ತೆಗೆದುಹಾಕಲಾಗಿದೆ.$\r$\n$\r$\nಬೆಂಬಲ: support@vellium.dev"
LangString MUI_UNTEXT_FINISH_INFO_REBOOT 1099 "ಪ್ರಕ್ರಿಯೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು. ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆ?"
LangString MUI_TEXT_FINISH_REBOOTNOW 1099 "ಈಗಲೇ ಮರುಪ್ರಾರಂಭಿಸಿ"
LangString MUI_TEXT_FINISH_REBOOTLATER 1099 "ನಾನು ನಂತರ ಮರುಪ್ರಾರಂಭಿಸುತ್ತೇನೆ"
LangString MUI_TEXT_FINISH_RUN 1099 "$(^NameDA) &ಪ್ರಾರಂಭಿಸಿ"
LangString MUI_TEXT_FINISH_SHOWREADME 1099 "Readme &ತೋರಿಸಿ"
LangString MUI_BUTTONTEXT_FINISH 1099 "&ಮುಕ್ತಾಯ"
LangString MUI_TEXT_ABORTWARNING 1099 "ನೀವು ಖಚಿತವಾಗಿ $(^Name) ಸೆಟಪ್‌ನಿಂದ ನಿರ್ಗಮಿಸಲು ಬಯಸುವಿರಾ?"
LangString MUI_UNTEXT_ABORTWARNING 1099 "ನೀವು ಖಚಿತವಾಗಿ $(^Name) ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್‌ನಿಂದ ನಿರ್ಗಮಿಸಲು ಬಯಸುವಿರಾ?"

LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\Gujarati.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1095 "Power Pilot સેટઅપમાં આપનું સ્વાગત છે"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1095 "Vellium દ્વારા નિર્મિત Power Pilot Windows પાવર મેનેજમેન્ટ અને નિર્ધારિત કાર્યોને સુરક્ષિત રીતે ઓટોમેટ કરે છે.$\r$\n$\r$\nતમારા બધા કાર્યો, સેટિંગ્સ અને સ્થાનિક AI મોડેલ્સ સંપૂર્ણપણે ઓફલાઇન તમારા PC પર રહે છે.$\r$\n$\r$\nચાલુ રાખવા માટે આગળ ક્લિક કરો."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1095 "Power Pilot અનઇન્સ્ટોલ"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1095 "આ વિઝાર્ડ તમારા કમ્પ્યુટરમાંથી Power Pilot (Vellium) ને દૂર કરશે.$\r$\n$\r$\nઆગલા પગલામાં તમે સ્થાનિક ડેટા રાખવો કે કાયમી કાઢી નાખવો તે પસંદ કરી શકો છો."
LangString MUI_TEXT_DIRECTORY_TITLE 1095 "ઇન્સ્ટોલેશન સ્થાન પસંદ કરો"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1095 "$(^NameDA) ઇન્સ્ટોલ કરવા માટે ફોલ્ડર પસંદ કરો."
LangString MUI_TEXT_INSTALLING_TITLE 1095 "ઇન્સ્ટોલ થઈ રહ્યું છે"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1095 "$(^NameDA) ઇન્સ્ટોલ થાય ત્યાં સુધી કૃપા કરીને રાહ જુઓ."
LangString MUI_TEXT_FINISH_TITLE 1095 "ઇન્સ્ટોલેશન પૂર્ણ"
LangString MUI_TEXT_FINISH_SUBTITLE 1095 "સેટઅપ સફળતાપૂર્વક પૂર્ણ થયું."
LangString MUI_TEXT_ABORT_TITLE 1095 "ઇન્સ્ટોલેશન રદ થયું"
LangString MUI_TEXT_ABORT_SUBTITLE 1095 "સેટઅપ સફળતાપૂર્વક પૂર્ણ થયું નથી."
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1095 "અનઇન્સ્ટોલ થઈ રહ્યું છે"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1095 "$(^NameDA) દૂર થાય ત્યાં સુધી કૃપા કરીને રાહ જુઓ."
LangString MUI_UNTEXT_FINISH_TITLE 1095 "અનઇન્સ્ટોલ પૂર્ણ"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1095 "અનઇન્સ્ટોલ સફળતાપૂર્વક પૂર્ણ થયું."
LangString MUI_UNTEXT_ABORT_TITLE 1095 "અનઇન્સ્ટોલ રદ થયું"
LangString MUI_UNTEXT_ABORT_SUBTITLE 1095 "અનઇન્સ્ટોલ સફળતાપૂર્વક પૂર્ણ થયું નથી."
LangString MUI_TEXT_FINISH_INFO_TITLE 1095 "Power Pilot ઇન્સ્ટોલેશન પૂર્ણ થયું"
LangString MUI_TEXT_FINISH_INFO_TEXT 1095 "Power Pilot તમારા કમ્પ્યુટર પર સફળતાપૂર્વક ઇન્સ્ટોલ થઈ ગયું છે.$\r$\n$\r$\nઆ વિઝાર્ડ બંધ કરવા માટે સમાપ્ત ક્લિક કરો."
LangString MUI_TEXT_FINISH_INFO_REBOOT 1095 "પ્રક્રિયા પૂર્ણ કરવા કમ્પ્યુટર રીસ્ટાર્ટ કરવું જરૂરી છે. હમણાં રીસ્ટાર્ટ કરવું છે?"
LangString MUI_UNTEXT_FINISH_INFO_TITLE 1095 "Power Pilot દૂર કરવામાં આવ્યું"
LangString MUI_UNTEXT_FINISH_INFO_TEXT 1095 "Power Pilot તમારા કમ્પ્યુટરમાંથી સફળતાપૂર્વક દૂર કરવામાં આવ્યું છે.$\r$\n$\r$\nસહાય: support@vellium.dev"
LangString MUI_UNTEXT_FINISH_INFO_REBOOT 1095 "પ્રક્રિયા પૂર્ણ કરવા કમ્પ્યુટર રીસ્ટાર્ટ કરવું જરૂરી છે. હમણાં રીસ્ટાર્ટ કરવું છે?"
LangString MUI_TEXT_FINISH_REBOOTNOW 1095 "હમણાં રીસ્ટાર્ટ કરો"
LangString MUI_TEXT_FINISH_REBOOTLATER 1095 "હું પછીથી જાતે રીસ્ટાર્ટ કરીશ"
LangString MUI_TEXT_FINISH_RUN 1095 "$(^NameDA) &ચલાવો"
LangString MUI_TEXT_FINISH_SHOWREADME 1095 "Readme &બતાવો"
LangString MUI_BUTTONTEXT_FINISH 1095 "&સમાપ્ત"
LangString MUI_TEXT_ABORTWARNING 1095 "શું તમે ખરેખર $(^Name) સેટઅપ બંધ કરવા માંગો છો?"
LangString MUI_UNTEXT_ABORTWARNING 1095 "શું તમે ખરેખર $(^Name) અનઇન્સ્ટોલ બંધ કરવા માંગો છો?"

LoadLanguageFile "${BUILD_RESOURCES_DIR}\nsis-langs\Malayalam.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1100 "Power Pilot സെറ്റപ്പിലേക്ക് സ്വാഗതം"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1100 "Vellium നിർമ്മിച്ച Power Pilot Windows പവർ മാനേജ്മെന്റും ഷെഡ്യൂൾ ചെയ്ത ജോലികളും സുരക്ഷിതമായി ഓട്ടോമേറ്റ് ചെയ്യുന്നു.$\r$\n$\r$\nഎല്ലാ ജോലികളും ക്രമീകരണങ്ങളും ലോക്കൽ AI മോഡലുകളും പൂർണ്ണമായും ഓഫ്‌ലൈനായി നിങ്ങളുടെ പിസിയിൽ തുടരും.$\r$\n$\r$\nതുടരാൻ അടുത്തത് ക്ലിക്കുചെയ്യുക."
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1100 "Power Pilot അൺഇൻസ്റ്റാൾ ചെയ്യുക"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1100 "ഈ വിസാർഡ് നിങ്ങളുടെ കമ്പ്യൂട്ടറിൽ നിന്ന് Power Pilot (Vellium) നീക്കം ചെയ്യും.$\r$\n$\r$\nഅടുത്ത ഘട്ടത്തിൽ ലോക്കൽ ഡാറ്റ സൂക്ഷിക്കണോ സ്ഥിരമായി മായ്ക്കണോ എന്ന് തിരഞ്ഞെടുക്കാം."
LangString MUI_TEXT_DIRECTORY_TITLE 1100 "ഇൻസ്റ്റാളേഷൻ സ്ഥാനം തിരഞ്ഞെടുക്കുക"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1100 "$(^NameDA) ഇൻസ്റ്റാൾ ചെയ്യേണ്ട ഫോൾഡർ തിരഞ്ഞെടുക്കുക."
LangString MUI_TEXT_INSTALLING_TITLE 1100 "ഇൻസ്റ്റാൾ ചെയ്യുന്നു"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1100 "$(^NameDA) ഇൻസ്റ്റാൾ ആകുന്നതുവരെ ദയവായി കാത്തിരിക്കുക."
LangString MUI_TEXT_FINISH_TITLE 1100 "ഇൻസ്റ്റാളേഷൻ പൂർത്തിയായി"
LangString MUI_TEXT_FINISH_SUBTITLE 1100 "സെറ്റപ്പ് വിജയകരമായി പൂർത്തിയായി."
LangString MUI_TEXT_ABORT_TITLE 1100 "ഇൻസ്റ്റാളേഷൻ റദ്ദാക്കി"
LangString MUI_TEXT_ABORT_SUBTITLE 1100 "സെറ്റപ്പ് വിജയകരമായി പൂർത്തിയായില്ല."
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1100 "അൺഇൻസ്റ്റാൾ ചെയ്യുന്നു"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1100 "$(^NameDA) നീക്കം ചെയ്യുന്നതുവരെ ദയവായി കാത്തിരിക്കുക."
LangString MUI_UNTEXT_FINISH_TITLE 1100 "അൺഇൻസ്റ്റാൾ പൂർത്തിയായി"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1100 "അൺഇൻസ്റ്റാൾ വിജയകരമായി പൂർത്തിയായി."
LangString MUI_UNTEXT_ABORT_TITLE 1100 "അൺഇൻസ്റ്റാൾ റദ്ദാക്കി"
LangString MUI_UNTEXT_ABORT_SUBTITLE 1100 "അൺഇൻസ്റ്റാൾ വിജയകരമായി പൂർത്തിയായില്ല."
LangString MUI_TEXT_FINISH_INFO_TITLE 1100 "Power Pilot ഇൻസ്റ്റാളേഷൻ പൂർത്തിയായി"
LangString MUI_TEXT_FINISH_INFO_TEXT 1100 "Power Pilot നിങ്ങളുടെ കമ്പ്യൂട്ടറിൽ വിജയകരമായി ഇൻസ്റ്റാൾ ചെയ്തു.$\r$\n$\r$\nഈ വിസാർഡ് അടയ്ക്കാൻ പൂർത്തിയാക്കുക ക്ലിക്കുചെയ്യുക."
LangString MUI_TEXT_FINISH_INFO_REBOOT 1100 "പ്രക്രിയ പൂർത്തിയാക്കാൻ കമ്പ്യൂട്ടർ റീസ്റ്റാർട്ട് ചെയ്യണം. ഇപ്പോൾ റീസ്റ്റാർട്ട് ചെയ്യണോ?"
LangString MUI_UNTEXT_FINISH_INFO_TITLE 1100 "Power Pilot നീക്കം ചെയ്തു"
LangString MUI_UNTEXT_FINISH_INFO_TEXT 1100 "Power Pilot നിങ്ങളുടെ കമ്പ്യൂട്ടറിൽ നിന്ന് വിജയകരമായി നീക്കം ചെയ്തു.$\r$\n$\r$\nപിന്തുണ: support@vellium.dev"
LangString MUI_UNTEXT_FINISH_INFO_REBOOT 1100 "പ്രക്രിയ പൂർത്തിയാക്കാൻ കമ്പ്യൂട്ടർ റീസ്റ്റാർട്ട് ചെയ്യണം. ഇപ്പോൾ റീസ്റ്റാർട്ട് ചെയ്യണോ?"
LangString MUI_TEXT_FINISH_REBOOTNOW 1100 "ഇപ്പോൾ റീസ്റ്റാർട്ട് ചെയ്യുക"
LangString MUI_TEXT_FINISH_REBOOTLATER 1100 "ഞാൻ പിന്നീട് റീസ്റ്റാർട്ട് ചെയ്യാം"
