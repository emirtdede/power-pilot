LoadLanguageFile "${NSISDIR}\Contrib\Language files\Khmer.nlf"
LangString MUI_TEXT_WELCOME_INFO_TITLE 1107 "សូមស្វាគមន៍ចំពោះការ​ដំឡើង​កម្មវិធី​ $(^NameDA)"
LangString MUI_TEXT_WELCOME_INFO_TEXT 1107 "កម្មវិធីជំនួយនេះនឹងនាំអ្នកដល់​ការ​ដំឡើង​កម្មវិធី​នៃកម្មវិធី $(^NameDA).$\r$\n$\r$\nIt ដែល​សូម​អោយ​អ្នក​បិទ​នូវ​កម្ម​វិធី​ទាំងឡាយ​ផ្សេង​ទៀត​មុន​ពេល​ចាប់ផ្តើម​ការ​ដំឡើង​។ ដើម្បី​ងាយ​ស្រួល​ក្នុង​ការ​កែប្រែ​ឯកសារ​នៃប្រព័ន្ធប្រតិបត្តការ​ដោយ​មិន​ចាំបាច់​ចាប់​ផ្តើម​ដំណើរ​ការ​ម៉ាស៊ីនរបស់​អ្នក​​សារ​ជា​ថ្មី។​ $\r$\n$\r$\n$_CLICK$\" #FIXME? BUGBUG: $\"It$\"?"
LangString MUI_UNTEXT_WELCOME_INFO_TITLE 1107 "ស្វាគមន៍​ចំពោះ​ការ​លុបកម្មវិធី​ $(^NameDA)​ នេះ"
LangString MUI_UNTEXT_WELCOME_INFO_TEXT 1107 "កម្មវិធីជំនួយនេះនឹងនាំអ្នកដល់​ការលុបចេញ​​នៃកម្មវិធី$(^NameDA).$\r$\n$\r$\n​ មុន​ពេល​ចាប់​ផ្តើម​លុប​ចេញ​ សូម​អោយ​ប្រាកដ​ថា​កម្មវិធី​ $(^NameDA) មិនមែន​កំពុង​ដំណើរ​ការ​$\r$\n$\r$\n$_CLICK"
LangString MUI_TEXT_DIRECTORY_TITLE 1107 "ជ្រើសរើស​កន្លែង​ដើម្បី​ដំឡើង​"
LangString MUI_TEXT_DIRECTORY_SUBTITLE 1107 "ជ្រើសរើសថត​ដើម្បី​ដំឡើង​កម្មវិធី​ $(^NameDA)​ ។"
LangString MUI_TEXT_INSTALLING_TITLE 1107 "កំពុងដំឡើង​"
LangString MUI_TEXT_INSTALLING_SUBTITLE 1107 "សូម​មេត្តា​រង់ចាំ​ខណះដែល​កម្មវិធី​ $(^NameDA) កំពុង​ត្រូវបាន​ដំឡើង​។"
LangString MUI_TEXT_FINISH_TITLE 1107 "ការដំឡើង​រួចរាល់​"
LangString MUI_TEXT_FINISH_SUBTITLE 1107 "ការ​ដំឡើង​ត្រូវ​បាន​បញ្ចប់ដោយ​ជោគជ័យ​"
LangString MUI_TEXT_ABORT_TITLE 1107 "ការដំឡើង​ត្រូវបាន​បញ្ឈប់​"
LangString MUI_TEXT_ABORT_SUBTITLE 1107 "ការ​ដំឡើង​ត្រូវបានបរាជ័យ។"
LangString MUI_UNTEXT_UNINSTALLING_TITLE 1107 "កំពុងដំណើរការ​លុប​"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE 1107 "សូមមេត្តារង់ចាំ​ខណះដែល​កម្មវិធី​ $(^NameDA) កំពុង​ត្រូវ​បាន​លុប​។"
LangString MUI_UNTEXT_FINISH_TITLE 1107 "ការ​លុប​ចេញ​រួច​រាល់​"
LangString MUI_UNTEXT_FINISH_SUBTITLE 1107 "ការ​លុប​ចេញ​ត្រូវបាន​បរាជ័យ​​។"
LangString MUI_UNTEXT_ABORT_TITLE 1107 "ការ​លុប​ចេញ​ត្រូវបាន​បញ្ឈប់​"
LangString MUI_UNTEXT_ABORT_SUBTITLE 1107 "ការ​លុប​ចេញ​ត្រូវបាន​បរាជ័យ"
LangString MUI_TEXT_FINISH_INFO_TITLE 1107 "កម្មវិធី​ជំនួយ​ក្នុងការ​ដំឡើង​ $(^NameDA) កំពុងត្រូវ​បាន​បញ្ចប់​"
LangString MUI_TEXT_FINISH_INFO_REBOOT 1107 "កុំព្យូទ័រ​របស់​អ្នក​ត្រូវតែ​ចាប់​ដំណើរ​ការ​សារ​ជាថ្មី​ដើម្បី​បំពេញ​ការ​ដំឡើង​កម្មវិធី​ $(^NameDA)​ នេះ។ តើ​អ្នក​ចង់ចាប់ផ្តើមដំណើរការ​​កុំព្យូទ័រអ្នក​ឡើង​វិញ​ពេល​នេះ​?"
LangString MUI_UNTEXT_FINISH_INFO_TITLE 1107 "កម្មវិធី​ជំនួយ​ក្នុងការ​លុប​ $(^NameDA) កំពុងត្រូវ​បាន​បញ្ចប់"
LangString MUI_UNTEXT_FINISH_INFO_REBOOT 1107 "កុំព្យូទ័រ​របស់​អ្នក​ត្រូវតែ​ចាប់​ដំណើរ​ការ​សារ​ជាថ្មី​ដើម្បី​បំពេញ​ការ​ដំឡើង​កម្មវិធី​ $(^NameDA)​ នេះ។ តើ​អ្នក​ចង់ចាប់ផ្តើមដំណើរការ​​កុំព្យូទ័រអ្នក​ឡើង​វិញ​ពេល​នេះ​?"
LangString MUI_TEXT_FINISH_REBOOTNOW 1107 "ចាប់ផ្តើមដំណើរការ​​កុំព្យូទ័រឡើង​វិញ​ពេល​នេះ​"
LangString MUI_TEXT_FINISH_REBOOTLATER 1107 "ចង់​ដំណើរការ​កុំព្យូទ័រ​ដោយ​ខ្លួន​ឯង​ពេល​ក្រោយ​"
LangString MUI_TEXT_ABORTWARNING 1107 "តើ​អ្នក​ប្រាកដ​ថា​នឹង​ចាក​ចេញ​ពី​ការ​ដំឡើង​កម្មវិធី​​ $(^Name) នេះ​មែន​ទេ​?"
LangString MUI_UNTEXT_ABORTWARNING 1107 "តើ​អ្នក​ប្រាកដ​ថា​នឹង​ចាក​ចេញ​ពី​ការ​លុបកម្មវិធី​​ $(^Name) នេះ​មែន​ទេ​?"
LangString MUI_TEXT_FINISH_INFO_TEXT 1107 "$(^NameDA) ត្រូវបានដំឡើងលើកុំព្យូទ័ររបស់អ្នកហើយ។$\r$\n$\r$\nចុច បញ្ចប់ ដើម្បីបិទ។"
LangString MUI_UNTEXT_FINISH_INFO_TEXT 1107 "$(^NameDA) ត្រូវបានលុបចេញពីកុំព្យូទ័ររបស់អ្នកហើយ។$\r$\n$\r$\nចុច បញ្ចប់ ដើម្បីបិទ។"
