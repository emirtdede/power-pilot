{
  "name": "powerpilot",
  "version": "1.0.0",
  "private": true,
  "description": "Smart, local-first power management and task automation for Windows.",
  "main": "main.js",
  "bin": {
    "powerpilot": "./src/cli/powerpilot.js",
    "powerpilot-mcp": "./src/mcp/server.js"
  },
  "scripts": {
    "start": "electron .",
    "mcp": "node src/mcp/server.js",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:locales": "node scripts/build-locales.mjs",
    "build:icons": "node scripts/generate-brand-assets.cjs && node scripts/generate-installer-assets.cjs",
    "build:nsis-i18n": "node scripts/generate-nsis-i18n.mjs",
    "build:setup-i18n": "node scripts/generate-setup-i18n.mjs",
    "prepack": "npm run build:renderer",
    "pack": "electron-builder --dir --config electron-builder.config.cjs --publish never",
    "pack:store": "electron-builder --dir --config electron-builder.store.cjs --publish never",
    "dist": "node scripts/build-setup.mjs",
    "dist:setup": "node scripts/build-setup.mjs",
    "dist:nsis": "electron-builder --win nsis --config electron-builder.config.cjs --publish never",
    "dist:setup-stub": "electron-builder --dir --config electron-builder.config.cjs --publish never && node scripts/build-setup.mjs --skip-pack",
    "dist:portable": "electron-builder --win portable --config electron-builder.config.cjs --publish never",
    "dist:appx": "node scripts/build-appx.js",
    "dist:store": "node scripts/build-appx.js --store",
    "verify:pack": "node scripts/verify-pack.js",
    "spike:pslist": "node scripts/spike-pslist.js",
    "release:rc": "node scripts/release-check.js --strict-git",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "node scripts/security-check.mjs",
    "test:smoke": "electron tests/smoke/electron-version.js",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test nav-keyboard settings-controls overlay-geometry target-size theme-boot mini-widget",
    "locales:check": "node scripts/check-i18n.js",
    "models:verify": "node scripts/verify-models.js",
    "release:check": "node scripts/release-check.js",
    "postinstall": "electron-rebuild",
    "verify:signature": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "test:load": "node --expose-gc scripts/load-test.mjs",
    "sbom": "node scripts/sbom.mjs",
    "audit:licenses": "node scripts/license-check.mjs",
    "winget:manifest": "node scripts/generate-winget-manifest.mjs"
  },
  "build": {
    "appId": "Vellium.PowerPilot",
    "productName": "Power Pilot",
    "files": [
      "**/*",
      "!dist/**",
      "!dist-*/**",
      "!test-results/**",
      "!playwright-report/**",
      "!blob-report/**",
      "!coverage/**",
      "!scratch/**",
      "!assets/**",
      "!ui_ux_audit_evidence/**",
      "!UI_UX_*.md",
      "!tests/**",
      "!docs/**",
      "!spikes/**",
      "!integrations/**",
      "!.github/**",
      "!QA_AUDIT_RAPORU.md",
      "!README.md",
      "!CHANGELOG.md",
      "!build-sign*.log",
      "!**/*.log",
      "!playwright.config.js",
      "!vitest.config.js",
      "!tailwind.config.js",
      "!electron-builder.config.cjs",
      "!electron-builder.store.cjs",
      "!.nvmrc",
      "!node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!node_modules/@node-llama-cpp/win-vulkan/**",
      "!node_modules/@node-llama-cpp/win-x64-vulkan/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/@fugood/node-whisper-win32-x64-cuda/**",
      "!node_modules/@fugood/node-whisper-win32-x64-vulkan/**",
      "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
      "!node_modules/better-sqlite3/prebuilds/linux-*.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-*.node",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!node_modules/@fugood/whisper.node/src/**",
      "!node_modules/@fugood/node-whisper-wasm/**",
      "!scripts/generate-*.cjs",
      "!scripts/generate-nsis-i18n.mjs",
      "!scripts/generate-setup-i18n.mjs",
      "!scripts/build-setup.mjs",
      "!scripts/nsis-i18n/**",
      "!scripts/setup-i18n/**",
      "!installer/**",
      "!**/*.map"
    ],
    "electronLanguages": [
      "en-US",
      "tr",
      "de",
      "sv",
      "nb",
      "da",
      "fr",
      "pl",
      "it",
      "nl",
      "cs",
      "es",
      "pt-BR",
      "pt-PT",
      "ja",
      "zh-CN",
      "ko",
      "ar"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/ps-list/vendor/*.exe",
      "src/assets/icons/*.ico",
      "src/assets/icons/*.png",
      "src/mcp/**",
      "src/cli/**",
      "src/shared/**",
      "src/agent/**"
    ],
    "extraResources": [
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "*.cmd"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icons/monochrome-dark.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "https://timestamp.digicert.com",
        "certificateSubjectName": "${env.WIN_CERT_SUBJECT}"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "emirtdede",
        "repo": "power-pilot",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icons/monochrome-dark.ico",
      "uninstallerIcon": "src/assets/icons/monochrome-dark.ico",
      "installerHeaderIcon": "src/assets/icons/monochrome-dark.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "en_US"
      ],
      "include": "build/installer.nsh"
    },
    "appx": {
      "artifactName": "${productName} ${version}.${ext}",
      "applicationId": "PowerPilot",
      "identityName": "Vellium.PowerPilot",
      "backgroundColor": "#09090b",
      "publisher": "${env.APPX_PUBLISHER}",
      "publisherDisplayName": "Vellium",
      "languages": [
        "TR-TR",
        "EN-US",
        "DE-DE",
        "SV-SE",
        "NB-NO",
        "DA-DK",
        "FR-FR",
        "PL-PL",
        "IT-IT",
        "NL-NL",
        "CS-CZ",
        "ES-ES",
        "PT-PT",
        "JA-JP",
        "ZH-CN",
        "KO-KR",
        "AR-SA"
      ],
      "makeappxArgs": [
        "/v"
      ]
    },
    "copyright": "Copyright © 2026 Vellium Teknoloji Anonim Şirketi. All rights reserved.",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "afterPack": "scripts/after-pack.cjs",
    "electronDist": "node_modules/electron/dist"
  },
  "author": {
    "name": "Vellium Teknoloji Anonim Şirketi",
    "email": "contact@vellium.dev",
    "url": "https://vellium.dev"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=24.18.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "43.8.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.2",
    "memfs": "4.80.0",
    "node-abi": "4.39.0",
    "png-to-ico": "3.0.1",
    "selfsigned": "^2.4.1",
    "tailwindcss": "^3.4.19",
    "vitest": "5.0.5"
  },
  "homepage": "https://vellium.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emirtdede/power-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/emirtdede/power-pilot/issues"
  },
  "keywords": [
    "electron",
    "power-management",
    "windows",
    "shutdown",
    "restart",
    "sleep",
    "hibernate",
    "automation"
  ],
  "overrides": {
    "simple-git": "4.0.2",
    "@simple-git/argv-parser": "2.0.1",
    "brace-expansion@5.0.4": "5.0.12"
  },
  "dependencies": {
    "@fugood/whisper.node": "^1.2.0-rc.1",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "canonicalize": "^5.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "ipaddr.js": "2.5.0",
    "node-llama-cpp": "^3.20.0",
    "ps-list": "9.0.0",
    "qrcode-generator": "^2.0.4",
    "systeminformation": "5.33.16"
  }
}